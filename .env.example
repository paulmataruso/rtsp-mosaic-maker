# ---------------------------------------------------------------------------
# Camera Mosaic Platform - environment configuration
# Copy to .env and adjust. All values shown are the built-in defaults.
# ---------------------------------------------------------------------------

# HTTP port the app (API + web UI) listens on. In Docker this is both the
# in-container port and (via APP_PORT in docker-compose.yml) the published port.
PORT=3333

# Public host/IP that Roku and other LAN clients use to reach MediaMTX,
# used only to render copyable RTSP URLs in the UI (does NOT affect routing).
# Leave blank to auto-detect from the address you open the web UI on.
# Set it explicitly only for reverse-proxy / VPN setups where the UI address
# is not the address LAN clients should use.
PUBLIC_HOST=

# Drizzle/SQLite database location (inside the container).
# For Postgres later: postgres://user:pass@host:5432/dbname
DATABASE_URL=file:/data/app.db

# MediaMTX Control API base URL (internal docker network).
MEDIAMTX_API_URL=http://mediamtx:9997

# RTSP endpoint FFmpeg publishes mosaics to (internal docker network).
MEDIAMTX_RTSP_URL=rtsp://mediamtx:8554

# RTSP port exposed to the LAN by MediaMTX (used only for display URLs).
MEDIAMTX_PUBLIC_RTSP_PORT=8554

# Optional credentials the app uses to publish to MediaMTX. Leave blank to
# publish anonymously (MediaMTX default config allows publish from private
# IP ranges). If set, they must match an entry in mediamtx.yml.
MEDIAMTX_PUBLISH_USER=
MEDIAMTX_PUBLISH_PASS=

# Secret used to derive the AES-256-GCM key that encrypts camera passwords
# at rest. MUST be set to a long random string in production. If unset, a
# key is derived from a file in the data dir (persisted, but less portable).
APP_SECRET=

# Optional single-user login for the web UI / API. When APP_AUTH_ENABLED is
# true a bearer token is required for all /api routes except /api/health.
APP_AUTH_ENABLED=false
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=
# JWT signing secret; auto-generated & persisted if left blank.
APP_JWT_SECRET=

# Logging.
LOG_LEVEL=info
# FFmpeg's own -loglevel (quiet, panic, fatal, error, warning, info, verbose, debug).
FFMPEG_LOG_LEVEL=warning

# Absolute path to the ffmpeg / ffprobe binaries. Defaults resolve from PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# TrueType font used by FFmpeg drawtext for tile labels & offline placeholders.
FFMPEG_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Timezone (affects log timestamps and drawtext clock if enabled).
TZ=UTC

# Hard ceiling on concurrently running mosaic FFmpeg processes (safety valve).
MAX_CONCURRENT_MOSAICS=8

# Hard ceiling on total input tiles across all running mosaics.
MAX_TOTAL_TILES=64
